generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ContentStatus {
  ACTIVE
  INACTIVE
}

enum ContactStatus {
  UNREAD
  READ
  ARCHIVED
}

model Admin {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password_hash String
  role          AdminRole @default(ADMIN)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model Setting {
  id                Int      @id @default(autoincrement())
  key               String   @unique @default("main")
  website_name      String?
  logo              String?
  phone             String?
  whatsapp          String?
  email             String?
  address           String?  @db.Text
  footer_text       String?  @db.Text
  facebook          String?
  youtube           String?
  ai_agent_settings Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model Announcement {
  id            Int           @id @default(autoincrement())
  title         String
  message       String        @db.Text
  status        ContentStatus @default(ACTIVE)
  display_order Int           @default(0)
  starts_at     DateTime?
  ends_at       DateTime?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
}

model PrincipalMessage {
  id         Int      @id @default(autoincrement())
  key        String   @unique @default("main")
  message    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Testimonial {
  id            Int      @id @default(autoincrement())
  student_name  String
  designation   String?
  testimonial   String   @db.Text
  photo         String?
  approved      Boolean  @default(false)
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model Contact {
  id         Int           @id @default(autoincrement())
  name       String
  phone      String?
  email      String?
  subject    String
  message    String        @db.Text
  status     ContactStatus @default(UNREAD)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
}
